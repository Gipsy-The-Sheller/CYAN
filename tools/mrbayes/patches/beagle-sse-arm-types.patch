+static inline __m128d _mm_shuffle_pd(__m128d a, __m128d b, const int imm) {
+    float64x2_t va = vreinterpretq_f64_m128d(a);
+    float64x2_t vb = vreinterpretq_f64_m128d(b);
+    float64x2_t out = vdupq_n_f64(0.0);
+    out = vsetq_lane_f64((imm & 0x1) ? vgetq_lane_f64(vb, 0) : vgetq_lane_f64(va, 0), out, 0);
+    out = vsetq_lane_f64((imm & 0x2) ? vgetq_lane_f64(vb, 1) : vgetq_lane_f64(va, 1), out, 1);
+    return out;
+}
 
