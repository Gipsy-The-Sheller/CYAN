+#if defined (WIN_VERSION)
+/* Number of physical cores, used to cap BEAGLE CPU threads. */
+static int MBGetPhysicalCoreCount (void)
+{
+    DWORD length = 0;
+    PSYSTEM_LOGICAL_PROCESSOR_INFORMATION buffer;
+    SYSTEM_INFO sysInfo;
+    int cores = 0;
+
+    if (!GetLogicalProcessorInformation (NULL, &length) &&
+        GetLastError () != ERROR_INSUFFICIENT_BUFFER)
+        {
+        GetSystemInfo (&sysInfo);
+        return (int) sysInfo.dwNumberOfProcessors;
+        }
+    if (length == 0)
+        {
+        GetSystemInfo (&sysInfo);
+        return (int) sysInfo.dwNumberOfProcessors;
+        }
+    buffer = (PSYSTEM_LOGICAL_PROCESSOR_INFORMATION) malloc (length);
+    if (buffer == NULL)
+        return 1;
+    if (GetLogicalProcessorInformation (buffer, &length))
+        {
+        DWORD offset = 0;
+        while (offset < length)
+            {
+            PSYSTEM_LOGICAL_PROCESSOR_INFORMATION info =
+                (PSYSTEM_LOGICAL_PROCESSOR_INFORMATION) ((BYTE *) buffer + offset);
+            if (info->Relationship == RelationProcessorCore)
+                cores++;
+            offset += sizeof (SYSTEM_LOGICAL_PROCESSOR_INFORMATION);
+            }
+        }
+    free (buffer);
+    if (cores < 1)
+        {
+        GetSystemInfo (&sysInfo);
+        cores = (int) sysInfo.dwNumberOfProcessors;
+        }
+    return cores;
+}
+#else
+/* Number of physical cores (macOS) or online logical CPUs (Linux), used to
+   cap BEAGLE CPU threads. */
+static int MBGetPhysicalCoreCount (void)
+{
+#if defined (__APPLE__)
+    int ncpu = 0;
+    size_t len = sizeof (ncpu);
+    if (sysctlbyname ("hw.physicalcpu", &ncpu, &len, NULL, 0) == 0 && ncpu > 0)
+        return ncpu;
+#endif
+#if defined (_SC_NPROCESSORS_ONLN)
+    long n = sysconf (_SC_NPROCESSORS_ONLN);
+    if (n > 0)
+        return (int) n;
+#endif
+    return 1;
+}
+#endif
