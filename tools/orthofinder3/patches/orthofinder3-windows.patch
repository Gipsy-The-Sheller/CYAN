@@ -3,5 +3,17 @@
 from scripts_of.__main__ import main
 
 if __name__ == "__main__":
+    # Required by PyInstaller on Windows: child processes are started by
+    # re-running this executable. Without freeze_support the child re-enters
+    # main() and recursively creates parallel task managers.
+    import multiprocessing
+    multiprocessing.freeze_support()
+    # Console code pages such as GBK cannot represent every byte that an
+    # external tool may emit; replacement keeps error reporting from crashing.
+    for stream in (sys.stdout, sys.stderr):
+        try:
+            stream.reconfigure(errors="replace")
+        except (AttributeError, ValueError):
+            pass
     args = sys.argv[1:]
     main(args)
