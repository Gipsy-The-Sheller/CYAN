diff --git a/src/stepwise.c b/src/stepwise.c
index 4586e52..839cc6e 100644
--- a/src/stepwise.c
+++ b/src/stepwise.c
@@ -82,8 +82,13 @@ static unsigned int * create_shuffled(unsigned int n, unsigned int seed)
     {
       int rint;
       pll_random_r(buf,&rint);
-      double r = ((double)rint / RAND_MAX);
+      /* pll_random_r returns a 31-bit value. Do not use RAND_MAX here: on
+         Windows/MinGW RAND_MAX is only 32767, which makes the index leave
+         the array. */
+      double r = ((double)rint / 2147483647.0);
       j = (unsigned int)(r * (i+1));
+      if (j > i)
+        j = i;
 
       PLL_SWAP(x[i],x[j]);
 
